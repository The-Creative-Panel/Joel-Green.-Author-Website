---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  // What shows as the blue link in Google: name + what he's known for (keep under ~60 characters)
  title = "Joel Green — Sci-Fi Author of The Halo | Astroseed Trilogy",
  description = "Joel Green — world architect, mythologist, aspiring novelist. Writing The Halo, Book One of the Astroseed Trilogy. Near-future. Corporate conspiracy. The truth costs everything.",
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs (https://joelgreenauthor.com)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const ogImageAlt = 'Joel Green. Writing The Halo, Book One of the Astroseed Trilogy.';

// Structured data (JSON-LD): tells Google who Joel Green is, what he's writing, and that
// this site and the blog (joelgreen.studio) belong to the same person.
const SITE = 'https://joelgreenauthor.com';
const BLOG = 'https://joelgreen.studio';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Joel Green',
      alternateName: 'Joel Green, Author',
      inLanguage: 'en',
      publisher: { '@id': `${SITE}/#joel-green` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${SITE}/#profile`,
      url: `${SITE}/`,
      name: title,
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: { '@id': `${SITE}/#joel-green` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#joel-green`,
      name: 'Joel Green',
      url: `${SITE}/`,
      jobTitle: 'Author',
      description: 'Sci-fi and dark fantasy writer, world architect and mythologist, writing The Halo, Book One of the Astroseed Trilogy, and developing Raven, a grimdark occult fantasy.',
      knowsAbout: ['Science fiction', 'Worldbuilding', 'Mythology', 'Thriller fiction'],
      // Same person as the author on the blog
      sameAs: [`${BLOG}/`, `${BLOG}/about/`],
      image: ogImage.href,
    },
    {
      '@type': 'Book',
      '@id': `${SITE}/#the-halo`,
      name: 'The Halo',
      author: { '@id': `${SITE}/#joel-green` },
      genre: ['Science fiction', 'Thriller'],
      description: 'A near-future sci-fi thriller about corporate power, survival, and a truth that costs everything.',
      inLanguage: 'en',
      creativeWorkStatus: 'In progress',
      isPartOf: { '@type': 'BookSeries', name: 'Astroseed Trilogy', author: { '@id': `${SITE}/#joel-green` } },
      position: 1,
    },
  ],
}).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- JG. monogram icon (public/favicon.svg); PNGs for older browsers and iPhone home screens -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (Facebook, LinkedIn, iMessage, Discord…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Joel Green" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Share image (public/og-default.png, 1200×630): shows as a card when the link is shared -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
  </html>
